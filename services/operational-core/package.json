{
  "name": "@aios/operational-core",
  "version": "0.1.0",
  "description": "AIOS Phase 1: vehicle master, parts master, integration/sync layer",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "jest --selectProjects unit",
    "test:pdf-docx": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects pdf-docx",
    "test:integration:pdf-docx": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects pdf-docx-integration --runInBand",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:integration:ai-benchmark": "jest --selectProjects integration --runInBand --testPathPattern=ai-benchmark",
    "test:integration:knowledge-platform": "jest --selectProjects integration --runInBand --testPathPattern=knowledge-platform",
    "test:all": "jest --runInBand --selectProjects unit integration",
    "test:watch": "jest --watch",
    "lint": "eslint \"{src,test}/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@prisma/client": "^5.22.0",
    "@types/mssql": "^12.3.0",
    "bcryptjs": "^3.0.3",
    "clamscan": "^2.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.3",
    "mammoth": "^1.12.0",
    "mssql": "^12.7.0",
    "otplib": "^13.4.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pg-logical-replication": "^2.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "selfsigned": "^5.5.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/clamscan": "^2.4.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "cross-env": "^10.1.0",
    "docx": "^9.7.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nock": "^14.0.16",
    "pdfkit": "^0.19.1",
    "prisma": "^5.22.0",
    "redis-memory-server": "^0.17.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "testPathIgnorePatterns": [
          ".*\\.integration-spec\\.ts$",
          "pdf\\.parser\\.spec\\.ts$"
        ],
        "transform": {
          "^.+\\.(t|j)s$": "ts-jest"
        },
        "transformIgnorePatterns": [
          "node_modules/(?!(otplib|@otplib|@scure|@noble)/)"
        ],
        "testEnvironment": "node"
      },
      {
        "displayName": "integration",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.integration-spec\\.ts$",
        "testPathIgnorePatterns": [
          "pdf-pipeline\\.integration-spec\\.ts$"
        ],
        "transform": {
          "^.+\\.(t|j)s$": "ts-jest"
        },
        "transformIgnorePatterns": [
          "node_modules/(?!(otplib|@otplib|@scure|@noble)/)"
        ],
        "testEnvironment": "node",
        "setupFiles": [
          "<rootDir>/test-setup-integration.ts"
        ],
        "globalSetup": "<rootDir>/test-global-setup-integration.ts"
      },
      {
        "displayName": "pdf-docx",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "rootDir": "src",
        "testRegex": "pdf\\.parser\\.spec\\.ts$",
        "transform": {
          "^.+\\.(t|j)s$": "ts-jest"
        },
        "transformIgnorePatterns": [
          "node_modules/(?!(otplib|@otplib|@scure|@noble)/)"
        ],
        "testEnvironment": "node"
      },
      {
        "displayName": "pdf-docx-integration",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "rootDir": "src",
        "testRegex": "pdf-pipeline\\.integration-spec\\.ts$",
        "transform": {
          "^.+\\.(t|j)s$": "ts-jest"
        },
        "transformIgnorePatterns": [
          "node_modules/(?!(otplib|@otplib|@scure|@noble)/)"
        ],
        "testEnvironment": "node",
        "setupFiles": [
          "<rootDir>/test-setup-integration.ts"
        ],
        "globalSetup": "<rootDir>/test-global-setup-integration.ts"
      }
    ]
  }
}
