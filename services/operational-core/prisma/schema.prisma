// AIOS Phase 1 — Vehicle master, Parts master, Integration/sync layer.
// See docs/architecture/01-data-model.md for the full target model;
// this schema implements only the fields flagged [P1] there.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

enum SyncStatus {
  PENDING
  SYNCED
  CONFLICT
  ERROR
}

enum DecodeConfidence {
  EXACT
  HIGH
  MEDIUM
  LOW
  UNVERIFIED
}

enum PartNumberType {
  ALTERNATE_OEM
  MANUFACTURER
  SUPPLIER
  SUPERSEDED
  CROSS_REFERENCE
}

enum MatchStage {
  RULE_BASED
  SIMILARITY
}

enum MatchCandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DeadLetterStage {
  VALIDATE
  NORMALIZE
  UPSERT
}

enum SyncRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

// Phase 2 adds LUBRICANTS_MANAGER, PURCHASING_OFFICER, SALESPERSON, AUDITOR.
// Existing Phase 1 values are kept exactly as-is (not renamed) — see
// docs/architecture/rbac-permissions.md for the mapping from this enum to
// the Phase 2 permission spec's role names (e.g. SYSTEM_ADMINISTRATOR here
// is that spec's "SYSTEM_ADMIN", READ_ONLY_VIEWER is its "VIEWER").
enum Role {
  SYSTEM_ADMINISTRATOR
  OWNER
  GENERAL_MANAGER
  BRANCH_MANAGER
  PARTS_MANAGER
  LUBRICANTS_MANAGER
  STOREKEEPER
  PURCHASING_OFFICER
  PURCHASING_MANAGER
  SALESPERSON
  DATA_QUALITY_REVIEWER
  AUDITOR
  READ_ONLY_VIEWER
  // Phase 3 garage roles. "Viewer" from the Phase 3 spec maps to
  // READ_ONLY_VIEWER (already exists) — see docs/architecture/garage-rbac.md.
  GARAGE_MANAGER
  WORKSHOP_SUPERVISOR
  RECEPTION
  TECHNICIAN
  DIAGNOSTIC_TECHNICIAN
  QUALITY_INSPECTOR
  SERVICE_ADVISOR
  // DGX Prototype 1.7 (Automotive Knowledge Platform) addition — a
  // dedicated technical/licensing knowledge-review persona. No existing
  // role's semantics fit (DATA_QUALITY_REVIEWER's read set is import/
  // mapping-quality focused, not technical-content-authority focused). See
  // docs/knowledge-platform/permissions-and-roles.md.
  KNOWLEDGE_STEWARD
}

// ---------------------------------------------------------------------------
// RBAC skeleton (Phase 1: enough to demonstrate guards; full CRM/user
// management is a later phase)
// ---------------------------------------------------------------------------

// Phase 1-4 used this purely for attribution (who reviewed a match, who
// resolved a dead letter) with no login of its own — the whole system ran
// on the x-user-role header stand-in. Phase 5's Identity Platform makes
// this the same table's row a real authenticatable identity instead of
// introducing a parallel AppUser model — every existing back-relation
// (PartMatchCandidate.reviewedBy, VehicleAttributeHistory.changedBy,
// SyncDeadLetter.resolvedBy) now points at a real logged-in user rather
// than a free-text attribution string. See docs/architecture/identity-platform.md.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      Role
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase 5 — Identity Platform additions. All nullable/defaulted so every
  // existing Phase 1-4 User row (and every existing test fixture) remains
  // valid without a data migration.
  passwordHash       String?
  isActive           Boolean   @default(true)
  isEmailVerified    Boolean   @default(false)
  mfaEnabled         Boolean   @default(false)
  mfaSecretEncrypted String? // AES-256-GCM ciphertext, never plaintext — see security-production.md
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime?

  reviewedMatchCandidates PartMatchCandidate[]      @relation("ReviewedBy")
  vehicleAttributeChanges VehicleAttributeHistory[]
  resolvedDeadLetters     SyncDeadLetter[]

  sessions                UserSession[]
  refreshTokens           RefreshToken[]
  loginHistory            LoginHistoryEntry[]
  devices                 TrustedDevice[]
  apiKeys                 ApiKey[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  notificationPreferences NotificationPreference[]
  notificationDispatches  NotificationDispatch[]

  entityMatchCandidatesReviewed EntityMatchCandidate[] @relation("EntityMatchReviewedBy")
  manualReviewItemsReviewed     ManualReviewItem[]     @relation("ManualReviewReviewedBy")

  @@index([role])
}

// ---------------------------------------------------------------------------
// Integration layer
// ---------------------------------------------------------------------------

model IntegrationSource {
  id                  String   @id @default(uuid())
  name                String   @unique // e.g. "LEGACY_POS", "LEGACY_ERP"
  adapterType         String // e.g. "FileDropAdapter", "PostgresCdcAdapter"
  lastCommittedCursor String? // opaque, adapter-owned
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Data Consolidation phase additions (nullable/additive — every existing
  // IntegrationSource row from Phase 1 remains valid unchanged). `name` is
  // reused directly as the unique feed identity required by
  // docs/data-consolidation/decision-log.md (e.g.
  // "MOLAS_CACHE_LUBRICANTS_CUSTOMERS") — this IS the fix for the
  // cursor-collision class of bug, not a new mechanism.
  extractionMode String? // "FULL_BACKFILL" | "INCREMENTAL" | "DATE_RANGE"
  schemaVersion  String?

  syncRuns SyncRun[]
}

model SyncRun {
  id              String            @id @default(uuid())
  sourceId        String
  source          IntegrationSource @relation(fields: [sourceId], references: [id])
  status          SyncRunStatus     @default(RUNNING)
  startedAt       DateTime          @default(now())
  finishedAt      DateTime?
  cursorBefore    String?
  cursorAfter     String?
  recordsFetched  Int               @default(0)
  recordsUpserted Int               @default(0)
  recordsSkipped  Int               @default(0)
  recordsFailed   Int               @default(0)
  error           String?

  // Data Consolidation phase: a SyncRun *is* an import batch — see the
  // note above RawRecordProcessingStatus.
  rawSourceRecords      RawSourceRecord[]
  reconciliationReports ReconciliationReport[]

  @@index([sourceId, startedAt])
}

model SyncDeadLetter {
  id             String          @id @default(uuid())
  sourceSystem   String
  sourceRecordId String
  entityType     String // "VEHICLE" | "PART"
  stage          DeadLetterStage
  rawPayload     Json
  error          String
  retryCount     Int             @default(0)
  firstSeenAt    DateTime        @default(now())
  lastSeenAt     DateTime        @default(now())
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?           @relation(fields: [resolvedById], references: [id])
  resolution     String?

  @@unique([sourceSystem, sourceRecordId, entityType, stage])
  @@index([sourceSystem, resolvedAt])
}

// ---------------------------------------------------------------------------
// Vehicle master
// ---------------------------------------------------------------------------

model Vehicle {
  id String @id @default(uuid())

  // sync envelope — nullable because a vehicle can be created natively (no source)
  sourceSystem   String?
  sourceRecordId String?
  externalId     String? // usually the VIN, kept separate so it survives a VIN correction
  syncedAt       DateTime?
  recordVersion  String?
  checksum       String?
  syncStatus     SyncStatus @default(SYNCED)
  syncError      String?

  vin                String?   @unique
  registrationNumber String?
  brand              String
  model              String
  variant            String?
  modelYear          Int?
  productionDate     DateTime?
  engineCode         String?
  engineFamily       String?
  displacementCc     Int?
  fuelType           String?
  powertrainType     String?
  transmissionCode   String?
  driveType          String?
  bodyType           String?
  marketSpec         String?

  // decode confidence per field, e.g. {"engineCode": "HIGH", "modelYear": "EXACT"}
  decodeConfidence Json?
  decodeSource     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributeHistory VehicleAttributeHistory[]

  // Phase 2 back-relations (docs/architecture/phase-2-commercial-foundation.md)
  customerLinks      CustomerVehicleLink[]
  salesLines         SalesDocumentLine[]
  appEvents          AppEvent[]
  lostSaleCandidates LostSaleCandidate[]

  // Phase 3 back-relations (docs/architecture/garage-architecture.md)
  receptions        VehicleReception[]
  garageJobs        GarageJob[]
  complaints        CustomerComplaint[]
  repeatRepairFlags RepeatRepairFlag[]
  notifications     NotificationEvent[]

  // Phase 4 back-relation (docs/architecture/dgx-platform.md)
  knowledgeDocuments KnowledgeDocument[]

  // DGX Prototype 1.7 back-relation (docs/knowledge-platform/applicability-model.md)
  knowledgeApplicabilities KnowledgeItemVehicleApplicability[]

  @@unique([sourceSystem, sourceRecordId])
  @@index([brand, model, modelYear])
}

model VehicleAttributeHistory {
  id          String           @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle          @relation(fields: [vehicleId], references: [id])
  field       String
  oldValue    String?
  newValue    String?
  reason      String?
  confidence  DecodeConfidence @default(UNVERIFIED)
  changedById String?
  changedBy   User?            @relation(fields: [changedById], references: [id])
  changedAt   DateTime         @default(now())

  @@index([vehicleId, field])
}

// ---------------------------------------------------------------------------
// Parts master
// ---------------------------------------------------------------------------

model Part {
  id String @id @default(uuid())

  sourceSystem   String?
  sourceRecordId String?
  externalId     String?
  syncedAt       DateTime?
  recordVersion  String?
  checksum       String?
  syncStatus     SyncStatus @default(SYNCED)
  syncError      String?

  internalItemCode        String? @unique
  oemNumber               String
  brand                   String?
  productName             String
  standardizedProductName String
  category                String?
  subcategory             String?
  // DGX Prototype 1 addition — real tecdoc_article_id values exist in the
  // raw oitm payload (see docs/data-sources/parts-catalogue-quality.md) but
  // were never promoted to the canonical Part row; TecDoc-identifier
  // retrieval (a named prototype capability) needs a real, indexed field
  // rather than reaching into RawSourceRecord JSON on every query.
  tecdocArticleId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alternateNumbers   PartAlternateNumber[]
  compatibility      PartCompatibility[]
  matchCandidatesAsA PartMatchCandidate[]  @relation("PartA")
  matchCandidatesAsB PartMatchCandidate[]  @relation("PartB")

  // Phase 2 back-relations (docs/architecture/phase-2-commercial-foundation.md)
  salesLines                SalesDocumentLine[]
  purchaseLines             PurchaseDocumentLine[]
  goodsReceiptLines         GoodsReceiptLine[]
  inventoryMovements        InventoryMovement[]
  inventoryBalances         InventoryBalance[]
  stockReservations         StockReservation[]
  stockTransferLines        StockTransferLine[]
  inventoryAdjustments      InventoryAdjustment[]
  stockSnapshots            StockSnapshot[]
  appEvents                 AppEvent[]
  lostSaleCandidates        LostSaleCandidate[]
  itemMetrics               InventoryItemMetric[]
  purchaseRecommendations   PurchaseRecommendation[]
  transferRecommendations   TransferRecommendation[]
  planningProfiles          ItemPlanningProfile[]
  garageJobLines            GarageJobLine[]
  requiredInInspections     InspectionResult[]
  estimateLines             EstimateLine[]
  workshopInventoryRequests WorkshopInventoryRequest[]
  knowledgeDocuments        KnowledgeDocument[]
  externalRefs              PartExternalReference[]
  relationshipsFrom         PartRelationship[]         @relation("RelationshipFrom")
  relationshipsTo           PartRelationship[]         @relation("RelationshipTo")
  knowledgeApplicabilities  KnowledgeItemPartApplicability[]

  @@unique([sourceSystem, sourceRecordId])
  @@index([oemNumber])
  @@index([standardizedProductName])
  @@index([tecdocArticleId])
}

model PartAlternateNumber {
  id     String         @id @default(uuid())
  partId String
  part   Part           @relation(fields: [partId], references: [id])
  number String
  type   PartNumberType

  @@unique([partId, number, type])
  @@index([number])
}

model PartCompatibility {
  id               String  @id @default(uuid())
  partId           String
  part             Part    @relation(fields: [partId], references: [id])
  brand            String
  model            String?
  modelYearFrom    Int?
  modelYearTo      Int?
  engineCode       String?
  transmissionCode String?

  @@index([brand, model])
  @@index([partId])
}

// Proposed duplicate/alternate matches between two part records.
// Never auto-merged — see docs/architecture/01-data-model.md §3.
model PartMatchCandidate {
  id           String               @id @default(uuid())
  partAId      String
  partA        Part                 @relation("PartA", fields: [partAId], references: [id])
  partBId      String
  partB        Part                 @relation("PartB", fields: [partBId], references: [id])
  stage        MatchStage
  score        Float
  rationale    String
  status       MatchCandidateStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?                @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime             @default(now())

  @@unique([partAId, partBId, stage])
  @@index([status])
}

// =============================================================================
// PHASE 2 — Commercial Data Foundation and Inventory Intelligence
// See docs/architecture/phase-2-commercial-foundation.md for the domain design
// and docs/architecture/decision-log.md for why each simplification was made.
// =============================================================================

enum ItemType {
  PART
  LUBRICANT
  LABOUR
  SERVICE
  MISCELLANEOUS
  UNKNOWN
}

enum RecommendationConfidence {
  HIGH
  MEDIUM
  LOW
  INSUFFICIENT_DATA
}

// ---------------------------------------------------------------------------
// 2.1 Organization and locations
// ---------------------------------------------------------------------------

enum WarehouseType {
  MAIN
  RETAIL
  GARAGE
  LUBRICANTS
  TRANSIT
  QUARANTINE
  DAMAGED
  RETURNS
}

model Organization {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches      Branch[]
  configuration OrganizationConfiguration?
}

model Branch {
  id             String       @id @default(uuid())
  code           String
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  address        String?
  phone          String?
  email          String?
  timezone       String       @default("Africa/Dar_es_Salaam")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  warehouses         Warehouse[]
  customers          Customer[]
  salesDocuments     SalesDocument[]
  purchaseDocuments  PurchaseDocument[]
  lostSaleCandidates LostSaleCandidate[]
  receptions         VehicleReception[]
  garageJobs         GarageJob[]
  technicians        Technician[]
  labourRates        LabourRate[]

  // Phase 5 — Branch Gateway / edge operations back-relations
  outboxMessages BranchOutboxMessage[]
  healthPings    BranchHealthPing[]

  // Data Consolidation phase — multi-source branch-code mapping
  externalRefs BranchExternalReference[]

  @@unique([organizationId, code])
}

model Warehouse {
  id                    String        @id @default(uuid())
  code                  String
  name                  String
  branchId              String
  branch                Branch        @relation(fields: [branchId], references: [id])
  warehouseType         WarehouseType @default(MAIN)
  isSellable            Boolean       @default(true)
  isServiceWarehouse    Boolean       @default(false)
  isTransitWarehouse    Boolean       @default(false)
  isQuarantineWarehouse Boolean       @default(false)
  isActive              Boolean       @default(true)
  // AI Foundation Certification Sprint — Phase II Sprint 1 (see
  // docs/adr/ADR-0001-warehouse-capacity.md). `null` = no real, known
  // capacity limit for this warehouse — additive, does not affect existing
  // behavior until a real value is set for a given warehouse.
  capacity              Decimal?      @db.Decimal(14, 3)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  salesDocuments            SalesDocument[]
  salesDocumentLines        SalesDocumentLine[]
  purchaseDocuments         PurchaseDocument[]
  goodsReceipts             GoodsReceipt[]
  inventoryMovements        InventoryMovement[]
  inventoryBalances         InventoryBalance[]
  stockReservations         StockReservation[]
  inventoryAdjustments      InventoryAdjustment[]
  stockSnapshots            StockSnapshot[]
  itemMetrics               InventoryItemMetric[]
  lostSaleCandidates        LostSaleCandidate[]
  purchaseRecommendations   PurchaseRecommendation[]
  transfersOut              StockTransfer[]              @relation("TransferSource")
  transfersIn               StockTransfer[]              @relation("TransferDestination")
  transferRecsAsSource      TransferRecommendation[]     @relation("TransferRecSource")
  transferRecsAsDestination TransferRecommendation[]     @relation("TransferRecDestination")
  garageJobs                GarageJob[]
  workshopInventoryRequests WorkshopInventoryRequest[]
  externalRefs              WarehouseExternalReference[]

  @@unique([branchId, code])
}

// ---------------------------------------------------------------------------
// 2.2 Customer master
// ---------------------------------------------------------------------------

enum CustomerType {
  INDIVIDUAL
  CORPORATE
  DEALER
  GARAGE
  FLEET
  GOVERNMENT
  INTERNAL
}

model Customer {
  id                String       @id @default(uuid())
  customerCode      String       @unique
  legalName         String
  displayName       String
  customerType      CustomerType @default(INDIVIDUAL)
  phone             String?
  secondaryPhone    String?
  email             String?
  taxNumber         String?
  creditLimit       Decimal?     @db.Decimal(14, 2)
  pricingGroup      String?
  preferredBranchId String?
  preferredBranch   Branch?      @relation(fields: [preferredBranchId], references: [id])
  isActive          Boolean      @default(true)

  // sync envelope — same pattern as Vehicle/Part (Phase 1). Nullable: a
  // customer can also be created natively, not just imported.
  sourceSystem   String?
  sourceRecordId String?
  externalId     String?
  syncedAt       DateTime?
  recordVersion  String?
  checksum       String?
  syncStatus     SyncStatus @default(SYNCED)
  syncError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts           CustomerContact[]
  addresses          CustomerAddress[]
  vehicleLinks       CustomerVehicleLink[]
  externalRefs       CustomerExternalReference[]
  salesDocuments     SalesDocument[]
  lostSaleCandidates LostSaleCandidate[]
  receptions         VehicleReception[]
  garageJobs         GarageJob[]

  @@unique([sourceSystem, sourceRecordId])
}

model CustomerContact {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  name       String?
  role       String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  label      String?
  line1      String?
  line2      String?
  city       String?
  region     String?
  country    String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// A vehicle may have more than one associated customer over its life (owner
// changes, fleet drivers) — kept as a link table rather than a scalar FK on
// Vehicle so history isn't lost when ownership changes.
model CustomerVehicleLink {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  relationship String   @default("OWNER") // OWNER | DRIVER | FLEET_MANAGER
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([customerId, vehicleId])
}

model CustomerExternalReference {
  id             String   @id @default(uuid())
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  sourceSystem   String
  sourceRecordId String
  createdAt      DateTime @default(now())

  @@unique([sourceSystem, sourceRecordId])
}

// ---------------------------------------------------------------------------
// 2.3 Lubricants master
// ---------------------------------------------------------------------------

enum LubricantCategory {
  ENGINE_OIL
  ATF
  DSG_FLUID
  GEAR_OIL
  DIFFERENTIAL_OIL
  TRANSFER_CASE_FLUID
  COOLANT
  BRAKE_FLUID
  HYDRAULIC_FLUID
  POWER_STEERING_FLUID
  ADBLUE
  ADDITIVE
  CLEANER
  WORKSHOP_CHEMICAL
}

model LubricantProduct {
  id                  String            @id @default(uuid())
  internalCode        String?           @unique
  brand               String
  productName         String
  normalizedName      String
  category            LubricantCategory
  viscosity           String?
  packageSize         Decimal?          @db.Decimal(10, 3)
  packageUnit         String?
  apiClassification   String?
  aceaClassification  String?
  currentCost         Decimal?          @db.Decimal(14, 4)
  defaultSellingPrice Decimal?          @db.Decimal(14, 4)
  isActive            Boolean           @default(true)

  sourceSystem   String?
  sourceRecordId String?
  externalId     String?
  syncedAt       DateTime?
  recordVersion  String?
  checksum       String?
  syncStatus     SyncStatus @default(SYNCED)
  syncError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvals        LubricantApproval[]
  compatibility    LubricantCompatibility[]
  alternativesFrom LubricantAlternative[]       @relation("AltFrom")
  alternativesTo   LubricantAlternative[]       @relation("AltTo")
  externalRefs     LubricantExternalReference[]

  salesLines                SalesDocumentLine[]
  purchaseLines             PurchaseDocumentLine[]
  goodsReceiptLines         GoodsReceiptLine[]
  inventoryMovements        InventoryMovement[]
  inventoryBalances         InventoryBalance[]
  stockReservations         StockReservation[]
  stockTransferLines        StockTransferLine[]
  inventoryAdjustments      InventoryAdjustment[]
  stockSnapshots            StockSnapshot[]
  appEvents                 AppEvent[]
  lostSaleCandidates        LostSaleCandidate[]
  itemMetrics               InventoryItemMetric[]
  purchaseRecommendations   PurchaseRecommendation[]
  transferRecommendations   TransferRecommendation[]
  planningProfiles          ItemPlanningProfile[]
  garageJobLines            GarageJobLine[]
  requiredInInspections     InspectionResult[]
  estimateLines             EstimateLine[]
  workshopInventoryRequests WorkshopInventoryRequest[]
  knowledgeDocuments        KnowledgeDocument[]

  @@unique([sourceSystem, sourceRecordId])
  @@index([normalizedName])
  @@index([category])
}

// Approvals are stored exactly as supplied by the source — never inferred.
// `isVerified` is a separate, human-set flag (see docs/architecture/phase-2-commercial-foundation.md §3).
model LubricantApproval {
  id                 String           @id @default(uuid())
  lubricantProductId String
  lubricantProduct   LubricantProduct @relation(fields: [lubricantProductId], references: [id])
  oemBrand           String
  approvalCode       String
  isVerified         Boolean          @default(false)
  createdAt          DateTime         @default(now())

  @@unique([lubricantProductId, oemBrand, approvalCode])
}

model LubricantCompatibility {
  id                  String           @id @default(uuid())
  lubricantProductId  String
  lubricantProduct    LubricantProduct @relation(fields: [lubricantProductId], references: [id])
  brand               String
  model               String?
  modelYearFrom       Int?
  modelYearTo         Int?
  engineCode          String?
  transmissionCode    String?
  serviceIntervalKm   Int?
  estimatedFillLitres Decimal?         @db.Decimal(6, 2)
  createdAt           DateTime         @default(now())

  @@index([brand, model])
}

// A proposed alternative between two lubricant products. Reuses Phase 1's
// MatchCandidateStatus enum deliberately: same "propose, never auto-approve"
// shape as PartMatchCandidate.
model LubricantAlternative {
  id              String               @id @default(uuid())
  lubricantId     String
  lubricant       LubricantProduct     @relation("AltFrom", fields: [lubricantId], references: [id])
  alternativeId   String
  alternative     LubricantProduct     @relation("AltTo", fields: [alternativeId], references: [id])
  alternativeType String // EXACT_APPROVED | COMPATIBLE | WORKSHOP_PREFERRED | BUDGET
  status          MatchCandidateStatus @default(PENDING)
  rationale       String?
  createdAt       DateTime             @default(now())

  @@unique([lubricantId, alternativeId])
}

model LubricantExternalReference {
  id                 String           @id @default(uuid())
  lubricantProductId String
  lubricantProduct   LubricantProduct @relation(fields: [lubricantProductId], references: [id])
  sourceSystem       String
  sourceRecordId     String
  createdAt          DateTime         @default(now())

  @@unique([sourceSystem, sourceRecordId])
}

// ---------------------------------------------------------------------------
// 2.4 Sales transactions
// ---------------------------------------------------------------------------

enum SalesDocumentType {
  QUOTATION
  SALES_ORDER
  DELIVERY
  INVOICE
  CREDIT_NOTE
  RETURN
  COUNTER_SALE
}

enum SalesDocumentStatus {
  DRAFT
  OPEN
  PARTIALLY_FULFILLED
  FULFILLED
  CLOSED
  CANCELLED
  RETURNED
}

model SalesDocument {
  id                     String              @id @default(uuid())
  documentNumber         String
  externalDocumentNumber String?
  documentType           SalesDocumentType
  status                 SalesDocumentStatus @default(OPEN)
  customerId             String?
  customer               Customer?           @relation(fields: [customerId], references: [id])
  // Raw source customer code when it doesn't resolve to a Customer master
  // record — see docs/architecture/phase-2-commercial-foundation.md §2.2 for
  // why this is a field rather than a separate "unresolved reference" table.
  unresolvedCustomerRef  String?
  branchId               String?
  branch                 Branch?             @relation(fields: [branchId], references: [id])
  warehouseId            String?
  warehouse              Warehouse?          @relation(fields: [warehouseId], references: [id])
  // Phase 3: a garage invoice reuses SalesDocument (documentType INVOICE)
  // rather than a parallel invoicing model — see garage-architecture.md.
  garageJobId            String?
  garageJob              GarageJob?          @relation(fields: [garageJobId], references: [id])
  salespersonExternalId  String?
  documentDate           DateTime
  postingDate            DateTime?
  dueDate                DateTime?
  currency               String              @default("TZS")
  exchangeRate           Decimal             @default(1) @db.Decimal(12, 6)
  subtotal               Decimal             @default(0) @db.Decimal(14, 2)
  discountTotal          Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal               Decimal             @default(0) @db.Decimal(14, 2)
  grandTotal             Decimal             @default(0) @db.Decimal(14, 2)
  paidAmount             Decimal             @default(0) @db.Decimal(14, 2)
  outstandingAmount      Decimal             @default(0) @db.Decimal(14, 2)
  isCancelled            Boolean             @default(false)

  sourceSystem   String?
  sourceRecordId String?
  externalId     String?
  syncedAt       DateTime?
  recordVersion  String?
  checksum       String?
  syncStatus     SyncStatus @default(SYNCED)
  syncError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines        SalesDocumentLine[]
  externalRefs SalesExternalReference[]

  @@unique([sourceSystem, sourceRecordId])
  @@index([documentNumber])
  @@index([branchId, documentDate])
  @@index([customerId])
}

model SalesDocumentLine {
  id                    String            @id @default(uuid())
  salesDocumentId       String
  salesDocument         SalesDocument     @relation(fields: [salesDocumentId], references: [id])
  lineNumber            Int
  itemType              ItemType          @default(UNKNOWN)
  partId                String?
  part                  Part?             @relation(fields: [partId], references: [id])
  lubricantProductId    String?
  lubricantProduct      LubricantProduct? @relation(fields: [lubricantProductId], references: [id])
  unresolvedItemCode    String?
  originalDescription   String?
  normalizedDescription String?
  quantity              Decimal           @db.Decimal(12, 3)
  unitPrice             Decimal           @db.Decimal(14, 4)
  discountAmount        Decimal           @default(0) @db.Decimal(14, 2)
  taxAmount             Decimal           @default(0) @db.Decimal(14, 2)
  lineTotal             Decimal           @db.Decimal(14, 2)
  costAtSale            Decimal?          @db.Decimal(14, 4)
  warehouseId           String?
  warehouse             Warehouse?        @relation(fields: [warehouseId], references: [id])
  vehicleId             String?
  vehicle               Vehicle?          @relation(fields: [vehicleId], references: [id])
  garageJobExternalId   String?

  sourceSystem   String?
  sourceRecordId String?
  checksum       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salesDocumentId, lineNumber])
  @@index([partId])
  @@index([lubricantProductId])
  @@index([vehicleId])
}

model SalesExternalReference {
  id              String        @id @default(uuid())
  salesDocumentId String
  salesDocument   SalesDocument @relation(fields: [salesDocumentId], references: [id])
  sourceSystem    String
  sourceRecordId  String
  createdAt       DateTime      @default(now())

  @@unique([sourceSystem, sourceRecordId])
}

// ---------------------------------------------------------------------------
// 2.5 Purchases
